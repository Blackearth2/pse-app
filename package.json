{
  "name": "revision-pse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web app de révision PSE1 / PSE2 : fiches, QCM, cas pratiques.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
